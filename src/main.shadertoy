
// Graphisme par ordinateur: Projet Personnel
// Description : Avion rouge volant au-dessus de l'eau.
// Instructions:
// 1. Create a new shader on Shadertoy.com
// 2. Add a 'Buffer A' tab (click the + sign at the top).
// 3. Paste the code from 'bufferA.shadertoy' into the Buffer A tab.
//    IMPORTANT SETTINGS FOR BUFFER A:
//    - iChannel0: Select 'Keyboard' (found in Misc or Inputs).
//    - iChannel1: Select 'Buffer A' (the buffer itself, for feedback).
// 4. Paste THIS code into the Image tab.
//    IMPORTANT SETTINGS FOR IMAGE:
//    - iChannel0: Select 'Buffer A'.

// --- Constants ---
#define MAX_STEPS 100
#define MAX_DIST 100.0
#define SURF_DIST 0.01
#define PI 3.14159265

// Materials
#define MAT_NONE 0.0
#define MAT_PLANE_RED 1.0
#define MAT_PLANE_COCKPIT 2.0
#define MAT_WATER 3.0
#define MAT_BIRD 4.0
#define MAT_LH_BASE 5.0
#define MAT_LH_LIGHT 6.0
#define MAT_BUILDING 7.0
#define MAT_DISC 8.0

// --- Utils ---
mat2 rot(float a) {
    float s = sin(a), c = cos(a);
    return mat2(c, -s, s, c);
}

float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5*(b-a)/k, 0.0, 1.0);
    return mix(b, a, h) - k*h*(1.0-h);
}

// Noise for waves
float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f*f*(3.0-2.0*f);
    return mix(mix(hash(i + vec2(0.0,0.0)), hash(i + vec2(1.0,0.0)), u.x),
               mix(hash(i + vec2(0.0,1.0)), hash(i + vec2(1.0,1.0)), u.x), u.y);
}

// --- SDF Primitives ---
float sdBox(vec3 p, vec3 b) {
    vec3 q = abs(p) - b;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float sdSphere(vec3 p, float s) {
    return length(p) - s;
}

float sdCylinder(vec3 p, float h, float r) {
    vec2 d = abs(vec2(length(p.xz), p.y)) - vec2(r, h);
    return min(max(d.x, d.y), 0.0) + length(max(d, 0.0));
}

float sdEllipsoid(vec3 p, vec3 r) {
    float k0 = length(p/r);
    float k1 = length(p/(r*r));
    return k0*(k0-1.0)/k1;
}

// --- Scene Logic ---
vec3 getPlanePos() {
    // Read position from Buffer A (iChannel0)
    float bufferPos = texelFetch(iChannel0, ivec2(0,0), 0).x;

    // Oscillation
    float osc = sin(iTime) * 3.0;

    // "center" of the oscillation defined by the buffer position
    float x = osc + bufferPos;

    return vec3(x, 4.5, 0.0); // y=4.5 (height), z=0 (plane is local 0, world moves)
}

// The world moves towards -z to simulate forward flight
float getWorldZ() {
    return iTime * 8.0;
}

// --- Map Function ---
vec2 map(vec3 p) {
    vec2 res = vec2(MAX_DIST, MAT_NONE);
    float zScroll = getWorldZ();

    // --- 1. The Red Plane (Player) ---
    // Positioned relative to camera/origin, does not scroll with world
    vec3 planePos = getPlanePos();
    vec3 pPlane = p - planePos;

    // Bank angle based on OSCILLATION
    float bufferPos = texelFetch(iChannel0, ivec2(0,0), 0).x;
    float oscillation = planePos.x - bufferPos;

    float bank = -oscillation * 0.1;

    pPlane.xy *= rot(bank);
    pPlane.yz *= rot(0.1); // Slight pitch up

    // Body
    float dBody = sdBox(pPlane, vec3(0.3, 0.3, 1.0));
    // Wings
    float dWings = sdBox(pPlane - vec3(0.0, 0.0, 0.2), vec3(1.8, 0.05, 0.4));
    float dPlane = smin(dBody, dWings, 0.1);

    // Cockpit (Blue)
    float dCockpit = sdBox(pPlane - vec3(0.0, 0.3, 0.3), vec3(0.25, 0.15, 0.4));

    // Combine Plane Parts
    if (dCockpit < dPlane) {
        if (dCockpit < res.x) res = vec2(dCockpit, MAT_PLANE_COCKPIT);
    } else {
        if (dPlane < res.x) res = vec2(dPlane, MAT_PLANE_RED);
    }

    // --- World Objects (Scroll with zScroll) ---
    vec3 pWorld = p;
    pWorld.z += zScroll; // Move world towards camera

    // --- 2. Water Surface (Plan with Noise) ---
    float waveH = noise(pWorld.xz * 0.2 + iTime * 0.5) * 0.5 + sin(pWorld.z * 0.5 + iTime)*0.2;
    float dWater = pWorld.y - waveH;
    if (dWater < res.x) res = vec2(dWater, MAT_WATER);

    // --- 3. Lighthouse (Cylinders) ---
    // Repeat every 60 units in Z
    vec3 pLh = pWorld;
    float lhZ = mod(pLh.z + 30.0, 60.0) - 30.0;
    vec3 lhPos = vec3(pLh.x - 11.0, pLh.y, lhZ); // Left side

    // Island Base
    float dIsland = sdCylinder(lhPos - vec3(0.0, -1.0, 0.0), 2.0, 2.0);
    // Tower
    float dTower = sdCylinder(lhPos - vec3(0.0, 2.0, 0.0), 3.0, 0.6);
    // Light Room (Yellow)
    float dLightRoom = sdCylinder(lhPos - vec3(0.0, 5.0, 0.0), 0.5, 0.7);

    float dLighthouse = smin(dIsland, dTower, 0.1);
    if (dLighthouse < res.x) res = vec2(dLighthouse, MAT_LH_BASE);
    if (dLightRoom < res.x) res = vec2(dLightRoom, MAT_LH_LIGHT);

    // --- 4. Buildings (Repeating Boxes) ---
    vec3 pBuild = pWorld;
    float bZ = mod(pBuild.z, 30.0) - 15.0;
    vec3 bPos = vec3(pBuild.x + 8.0, pBuild.y, bZ);
    float dBuild = sdBox(bPos - vec3(0.0, 1.0, 0.0), vec3(1.5, 3.0, 1.5));
    if (dBuild < res.x) res = vec2(dBuild, MAT_BUILDING);

    // --- 5. Articulated Bird ---
    // Flies across
    vec3 pBird = pWorld;
    pBird.z = mod(pBird.z + 15.0, 40.0) - 20.0;
    pBird.x += sin(iTime)*5.0;
    pBird.y -= 6.0; // Higher up

    // Body
    float dBirdBody = sdEllipsoid(pBird, vec3(0.15, 0.1, 0.4));
    // Wings (Flapping)
    float wingCycle = sin(iTime * 15.0);
    vec3 pWing = pBird;
    pWing.x = abs(pWing.x) - 0.1; // Symmetry
    pWing.xy *= rot(wingCycle * 0.5);
    float dBirdWing = sdEllipsoid(pWing - vec3(0.4, 0.0, 0.0), vec3(0.5, 0.05, 0.2));

    float dBird = smin(dBirdBody, dBirdWing, 0.05);
    if (dBird < res.x) res = vec2(dBird, MAT_BIRD);

    // --- 6. Disc (Non-aligned, cutting water) ---
    // Placed once every 100 units
    vec3 pDisc = pWorld;
    float discZ = mod(pDisc.z + 50.0, 100.0) - 50.0;
    vec3 discPos = vec3(pDisc.x + 3.0, pDisc.y, discZ);

    // Rotate disc to be non-aligned
    discPos.yz *= rot(0.5);
    discPos.xy *= rot(0.5);

    // A thin cylinder approximates a 2D disc
    float dDisc = sdCylinder(discPos, 0.02, 2.0);

    if (dDisc < res.x) res = vec2(dDisc, MAT_DISC);

    return res;
}

// --- Normals ---
vec3 calcNormal(vec3 p) {
    vec2 e = vec2(SURF_DIST, 0.0);
    return normalize(vec3(
        map(p+e.xyy).x - map(p-e.xyy).x,
        map(p+e.yxy).x - map(p-e.yxy).x,
        map(p+e.yyx).x - map(p-e.yyx).x
    ));
}

// --- Shadows ---
float softShadow(vec3 ro, vec3 rd, float minT, float maxT, float k) {
    float res = 1.0;
    float t = minT;
    for(int i=0; i<30; i++) {
        float h = map(ro + rd*t).x;
        if(h<0.001) return 0.0;
        res = min(res, k*h/t);
        t += h;
        if(t>maxT) break;
    }
    return res;
}

// --- Lighting & Shading ---
vec3 getLight(vec3 p, vec3 n, vec3 rd, float matID) {
    // Day/Night Cycle
    float cycle = iTime * 0.3;
    float dayFactor = 0.5 + 0.5*sin(cycle);

    // Sun/Moon Position
    vec3 sunDir = normalize(vec3(sin(cycle), cos(cycle) + 0.2, -0.5));
    vec3 sunCol = vec3(1.0, 0.95, 0.8);
    vec3 moonCol = vec3(0.1, 0.1, 0.2);
    vec3 lightCol = mix(moonCol, sunCol, dayFactor);
    vec3 lightDir = sunDir;

    // Ambient
    vec3 ambient = vec3(0.1) * max(dayFactor, 0.2);

    // Diffuse
    float diff = max(dot(n, lightDir), 0.0);

    // Shadow
    float shadow = softShadow(p + n*0.02, lightDir, 0.05, 20.0, 8.0);
    diff *= shadow;

    // Specular
    vec3 ref = reflect(rd, n);
    float spec = pow(max(dot(ref, lightDir), 0.0), 16.0);

    // Lighthouse Point Light (Yellow) - always on at night
    vec3 col = vec3(0.0);

    // Material Colors
    if (matID == MAT_PLANE_RED) col = vec3(0.8, 0.1, 0.1);
    else if (matID == MAT_PLANE_COCKPIT) {
        col = vec3(0.1, 0.3, 0.8);
        spec *= 2.0; // Shiny
    }
    else if (matID == MAT_WATER) {
        col = vec3(0.1, 0.2, 0.4);
        spec *= 3.0; // Wet
        // Reflection handled in main
    }
    else if (matID == MAT_BIRD) col = vec3(0.9);
    else if (matID == MAT_LH_BASE) col = vec3(0.7); // Gray
    else if (matID == MAT_LH_LIGHT) {
        if (dayFactor > 0.3) {
            // Day: Light Blue, Transparent-ish
            col = vec3(0.6, 0.8, 1.0);
            spec *= 5.0; // Very Shiny glass
        } else {
            // Night: Yellow emission
            col = vec3(1.0, 1.0, 0.0);
            return col * 3.0; // Bright Emissive, ignores shading
        }
    }
    else if (matID == MAT_BUILDING) col = vec3(0.4, 0.3, 0.3);
    else if (matID == MAT_DISC) {
        col = vec3(0.8, 0.4, 0.0); // Orange/Copper
        spec *= 2.0;
    }

    // Combine
    vec3 lin = ambient + lightCol * diff;

    // Additional Point Light from Lighthouse (Night only)
    if (dayFactor < 0.3) {
        // Calculate nearest lighthouse position in camera space
        float worldZ = p.z + getWorldZ();
        float lhPeriod = 60.0;
        float lhInstanceZ = floor((worldZ + lhPeriod * 0.5) / lhPeriod) * lhPeriod;
        vec3 lhPos = vec3(6.0, 5.0, lhInstanceZ - getWorldZ());

        vec3 ld = lhPos - p;
        float distSq = dot(ld, ld);
        float att = 1.0 / (1.0 + distSq * 0.05);

        if (att > 0.001) {
            vec3 ldN = normalize(ld);
            float diffPt = max(dot(n, ldN), 0.0);

            // Specular from Point Light
            vec3 ref = reflect(rd, n);
            float specPt = pow(max(dot(ref, ldN), 0.0), 16.0);

            lin += vec3(1.0, 0.8, 0.2) * (diffPt * 5.0 + specPt * 2.0) * att;
        }
    }

    col = col * lin + spec * lightCol * 0.5;

    return col;
}

// --- Main Render Loop ---
void mainImage( out vec4 fragColor, in vec2 fragCoord ) {
    vec2 uv = (fragCoord - 0.5*iResolution.xy)/iResolution.y;

    // Camera Setup (Follow Plane)
    vec3 planeP = getPlanePos();
    vec3 ro = vec3(planeP.x, 15.0, planeP.z - 8.0); // High up, behind
    vec3 lookAt = planeP + vec3(0.0, 0.0, 5.0); // Look ahead of plane

    // Camera Matrix
    vec3 f = normalize(lookAt - ro);
    vec3 r = normalize(cross(vec3(0,1,0), f));
    vec3 u = cross(f, r);
    vec3 rd = normalize(f + uv.x*r + uv.y*u);

    // Background (Sky)
    float cycle = iTime * 0.3;
    float dayFactor = 0.5 + 0.5*sin(cycle);
    vec3 col = mix(vec3(0.05, 0.05, 0.1), vec3(0.5, 0.7, 0.9), dayFactor);
    col = mix(col, vec3(0.8, 0.4, 0.2), clamp(1.0 - abs(rd.y)*2.0, 0.0, 1.0) * dayFactor); // Horizon

    // Raymarching
    float t = 0.0;
    float id = MAT_NONE;
    bool hit = false;

    for(int i=0; i<MAX_STEPS; i++) {
        vec3 p = ro + rd * t;
        vec2 d = map(p);

        if(d.x < SURF_DIST) {
            hit = true;
            id = d.y;
            // FIX: Transparency for now just simple color mixing
            break;
        }

        t += d.x;
        if(t > MAX_DIST) break;
    }

    if(hit) {
        vec3 p = ro + rd * t;
        vec3 n = calcNormal(p);
        vec3 objCol = getLight(p, n, rd, id);

        // Reflection for Water
        if (id == MAT_WATER) {
            // Simple reflection: bounce ray once
            vec3 refDir = reflect(rd, n);
            vec3 refCol = mix(vec3(0.05, 0.05, 0.1), vec3(0.5, 0.7, 0.9), dayFactor); // Sky reflection default

            // Quick march for reflection (limited steps)
            float tRef = 0.1;
            bool hitRef = false;
            for(int j=0; j<40; j++) {
                vec3 pRef = p + refDir * tRef;
                vec2 dRef = map(pRef);
                if(dRef.x < SURF_DIST) {
                    // Hit something in reflection
                    vec3 nRef = calcNormal(pRef);
                    // Lighting for reflected object
                    refCol = getLight(pRef, nRef, refDir, dRef.y);
                    hitRef = true;
                    break;
                }
                tRef += dRef.x;
                if(tRef > 50.0) break;
            }

            // Fresnel mixing: "mi-bleu et mi-mirroir"
            float fresnel = pow(1.0 - max(dot(n, -rd), 0.0), 3.0);
            objCol = mix(objCol, refCol, 0.5 + 0.4 * fresnel);
        }

        // Transparent Cockpit & Lighthouse Top (Day)
        if (id == MAT_PLANE_COCKPIT || (id == MAT_LH_LIGHT && dayFactor > 0.3)) {
            objCol = mix(objCol, col, 0.4); // Mix with sky/bg a bit
        }

        col = objCol;

        // Fog
        col = mix(col, mix(vec3(0.05, 0.05, 0.1), vec3(0.5, 0.7, 0.9), dayFactor), 1.0 - exp(-0.02 * t));
    }

    // Tone mapping
    col = pow(col, vec3(0.4545));

    fragColor = vec4(col, 1.0);
}
